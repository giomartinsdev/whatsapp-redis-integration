# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=whatsapp_db
DATABASE_URL=postgresql://user:password@db:5432/whatsapp_db

# Redis Configuration
REDIS_URL=redis://valkey:6379/0

# Observability (OpenTelemetry)
ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint.com
CLF_SERVICE_TOKEN_CLIENT_ID=your_client_id
CLF_SERVICE_TOKEN_CLIENT_SECRET=your_client_secret

